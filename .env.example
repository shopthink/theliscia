# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable / anon). Pode aparecer no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret / service_role). SOMENTE no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Texto aleatório longo, usado para anonimizar IPs no limite de tentativas.
HASH_SALT=
# Endereço público do site (para o link da campanha), ex.: https://pedidos.theliscia.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
